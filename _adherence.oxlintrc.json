{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/data/**",
              "components/layout/**",
              "research/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Petrobras Sans))/i]",
        "message": "Font not provided by the design system. Available: Petrobras Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgendaList'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|columns|numberColor|style|key|ref|className|style|children)$/]",
        "message": "<AgendaList> doesn't accept that prop. Declared props: items, columns, numberColor, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BulletList'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|marker|markerColor|size|gap|style|key|ref|className|style|children)$/]",
        "message": "<BulletList> doesn't accept that prop. Declared props: items, marker, markerColor, size, gap, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BulletList'] > JSXAttribute[name.name='marker'] > Literal[value!=/^(?:bullet|dash|none)$/]",
        "message": "<BulletList> marker must be one of 'bullet' | 'dash' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChapterCover'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|title|shapeSrc|style|key|ref|className|style|children)$/]",
        "message": "<ChapterCover> doesn't accept that prop. Declared props: number, title, shapeSrc, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContactCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|email|phone|style|key|ref|className|style|children)$/]",
        "message": "<ContactCard> doesn't accept that prop. Declared props: name, email, phone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContentPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|accent|padding|style|key|ref|className|style|children)$/]",
        "message": "<ContentPanel> doesn't accept that prop. Declared props: children, tone, accent, padding, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContentPanel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutro|verde)$/]",
        "message": "<ContentPanel> tone must be one of 'neutro' | 'verde'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTable'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|rows|style|key|ref|className|style|children)$/]",
        "message": "<DataTable> doesn't accept that prop. Declared props: columns, rows, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FarolList'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|style|key|ref|className|style|children)$/]",
        "message": "<FarolList> doesn't accept that prop. Declared props: items, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footnote'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|long|style|key|ref|className|style|children)$/]",
        "message": "<Footnote> doesn't accept that prop. Declared props: children, long, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoFigure'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|caption|credit|height|style|key|ref|className|style|children)$/]",
        "message": "<PhotoFigure> doesn't accept that prop. Declared props: src, alt, caption, credit, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pictogram'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|size|label|style|key|ref|className|style|children)$/]",
        "message": "<Pictogram> doesn't accept that prop. Declared props: src, alt, size, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuoteCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|support|panelSrc|style|key|ref|className|style|children)$/]",
        "message": "<QuoteCard> doesn't accept that prop. Declared props: quote, support, panelSrc, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RiskThermometer'] > JSXAttribute > JSXIdentifier[name!=/^(?:levels|marks|height|barSrc|caption|style|key|ref|className|style|children)$/]",
        "message": "<RiskThermometer> doesn't accept that prop. Declared props: levels, marks, height, barSrc, caption, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:sectionLabel|variant|badge|logo|logoSrc|badgeSrc|style|children|key|ref|className|style|children)$/]",
        "message": "<SlideFrame> doesn't accept that prop. Declared props: sectionLabel, variant, badge, logo, logoSrc, badgeSrc, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideFrame'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:white|green|photo)$/]",
        "message": "<SlideFrame> variant must be one of 'white' | 'green' | 'photo'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideTitle'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|color|rule|ruleColor|size|style|key|ref|className|style|children)$/]",
        "message": "<SlideTitle> doesn't accept that prop. Declared props: children, color, rule, ruleColor, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatHighlight'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|color|style|key|ref|className|style|children)$/]",
        "message": "<StatHighlight> doesn't accept that prop. Declared props: label, value, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusLegend'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|prefix|style|key|ref|className|style|children)$/]",
        "message": "<StatusLegend> doesn't accept that prop. Declared props: items, prefix, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
